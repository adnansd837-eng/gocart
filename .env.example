# ==========================================
# GoCart DevOps Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gocart
DATABASE_PORT=5432

# Backend API Configuration
BACKEND_PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gocart?schema=public
# Docker Compose internal URL:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gocart?schema=public
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_CURRENCY_SYMBOL=$
NEXT_PUBLIC_API_URL=http://localhost:5000/api
