{
  "name": "gocart-backend",
  "version": "1.0.0",
  "description": "GoCart E-Commerce Backend API with PostgreSQL and Prisma ORM",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test": "node --test test/smoke.test.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0"
  },
  "keywords": [
    "gocart",
    "ecommerce",
    "backend",
    "express",
    "postgresql",
    "prisma",
    "devops"
  ],
  "author": "",
  "license": "MIT"
}
