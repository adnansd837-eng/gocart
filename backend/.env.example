# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gocart?schema=public"

# In Docker Compose (using container service name 'postgres'):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/gocart?schema=public"

# CORS configuration (Frontend URL)
CORS_ORIGIN="http://localhost:3000"
